{
  "headers": [
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        },
        {
          "key": "X-Robots-Tag",
          "value": "all"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/collections",
      "destination": "/collection",
      "permanent": true
    },
    {
      "source": "/women",
      "destination": "/collection",
      "permanent": true
    },
    {
      "source": "/new-arrivals",
      "destination": "/new-in",
      "permanent": true
    },
    {
      "source": "/concierge",
      "destination": "/wardrobe-concierge",
      "permanent": true
    },
    {
      "source": "/personal-styling",
      "destination": "/wardrobe-concierge",
      "permanent": true
    },
    {
      "source": "/returns-exchanges",
      "destination": "/returns",
      "permanent": true
    },
    {
      "source": "/privacy",
      "destination": "/privacy-policy",
      "permanent": true
    },
    {
      "source": "/terms",
      "destination": "/terms-conditions",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/robots.txt",
      "destination": "/robots.txt"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
