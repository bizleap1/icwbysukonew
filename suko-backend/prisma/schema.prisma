generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── USER ────────────────────────────────────────────────────────────────────

model User {
  id                 Int                 @id @default(autoincrement())
  name               String?
  phone              String?
  email              String              @unique
  password_hash      String
  role               String              @default("customer") // "customer" | "cashier" | "inventory_staff" | "store_manager" | "admin" | "super_admin"
  reset_otp          String?
  reset_otp_expiry   DateTime?
  last_login         DateTime?
  last_active_at     DateTime?
  is_online          Boolean             @default(false)
  created_at         DateTime            @default(now())
  orders             Order[]
  cartItems          CartItem[]
  addresses          Address[]
  wishlistItems      Wishlist[]
  reviews            Review[]
  stockNotifications StockNotification[]
  staffSales         Sale[]              @relation("StaffSales")
  auditLogs          AdminAuditLog[]

  @@index([role])
  @@index([email])
  @@index([last_login])
  @@index([last_active_at])
}

// ─── CATEGORY ────────────────────────────────────────────────────────────────

model Category {
  id       Int       @id @default(autoincrement())
  name     String
  products Product[]
}

// ─── PRODUCT ─────────────────────────────────────────────────────────────────

model Product {
  id                 Int                 @id @default(autoincrement())
  name               String
  description        String?
  price              Decimal
  stock              Int                 @default(0) // @deprecated — COMPAT FIELD. Sum of variant stocks. Use ProductVariant.stock as source of truth.
  image_url          String?
  images             String[]            @default([])
  category_id        Int?
  sub_category       String?
  sizes              String[]            @default([])
  size_stock         Json?               @default("{}") // @deprecated — COMPAT FIELD. Computed from variants.
  low_stock_alert    Int                 @default(2)
  whatsapp_inquiry   Boolean             @default(false) // If true, product shows WhatsApp inquiry button instead of price/buy
  mrp_price          Decimal?            // Strikethrough MRP price before discount
  discount_percent   Int?                // Calculated discount percentage
  is_on_sale         Boolean             @default(false)
  promo_label        String?             // e.g. "FESTIVE SALE", "15% OFF"
  category           Category?           @relation(fields: [category_id], references: [id])
  created_at         DateTime            @default(now())
  updated_at         DateTime            @default(now()) @updatedAt
  variants           ProductVariant[]
  cartItems          CartItem[]
  orderItems         OrderItem[]
  wishlistItems      Wishlist[]
  reviews            Review[]
  stockNotifications StockNotification[]
  saleItems          SaleItem[]
  inventoryMovements InventoryMovement[]
  returnRequests     ReturnRequest[]

  @@index([category_id])
  @@index([name])
}

// ─── PRODUCT VARIANT (Authoritative Inventory) ──────────────────────────────

model ProductVariant {
  id                 Int                 @id @default(autoincrement())
  product_id         Int
  sku                String              @unique
  barcode            String?             @unique // EAN/UPC barcode for POS scanning
  size               String // "S", "M", "L", "XL", "Free Size"
  color              String?             @default("Default")
  price              Decimal
  mrp_price          Decimal?            // Strikethrough MRP for variant
  cost_price         Decimal?            @default(0) // Default / baseline cost price
  stock              Int                 @default(0) // ★ AUTHORITATIVE PHYSICAL STOCK — total on hand
  reserved_stock     Int                 @default(0) // ★ CURRENTLY HELD IN ACTIVE CHECKOUTS
  low_stock_alert    Int                 @default(2)
  is_active          Boolean             @default(true)
  created_at         DateTime            @default(now())
  updated_at         DateTime            @updatedAt
  product            Product             @relation(fields: [product_id], references: [id], onDelete: Cascade)
  cartItems          CartItem[]
  orderItems         OrderItem[]
  saleItems          SaleItem[]
  inventoryMovements InventoryMovement[]
  purchaseItems      PurchaseItem[]
  returnItems        ReturnRequest[]     @relation("ReturnVariant")
  exchangeItems      ReturnRequest[]     @relation("ExchangeVariant")

  @@index([product_id])
  @@index([barcode])
  @@index([size])
}

// ─── INVENTORY MOVEMENT LEDGER ───────────────────────────────────────────────

model InventoryMovement {
  id             Int             @id @default(autoincrement())
  variant_id     Int?
  product_id     Int
  type           String // "PURCHASE" | "ONLINE_ORDER" | "POS_SALE" | "RETURN" | "EXCHANGE_IN" | "EXCHANGE_OUT" | "CANCELLATION" | "MANUAL_ADJUSTMENT" | "DAMAGE" | "RESTOCK" | "STOCK_CORRECTION"
  quantity       Int // Delta: e.g. -1 for sale, +5 for restock
  stock_before   Int
  stock_after    Int
  reference_type String? // "POS_SALE" | "ONLINE_ORDER" | "RETURN" | "PURCHASE" | "MANUAL"
  reference_id   String? // Invoice Number or Order ID
  note           String?
  created_by     String? // Staff Email/Name
  created_at     DateTime        @default(now())
  variant        ProductVariant? @relation(fields: [variant_id], references: [id], onDelete: SetNull)
  product        Product         @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@index([variant_id])
  @@index([product_id])
  @@index([type])
  @@index([reference_id])
  @@index([created_at])
}

// ─── CART ─────────────────────────────────────────────────────────────────────

model CartItem {
  id         Int             @id @default(autoincrement())
  user_id    Int
  product_id Int
  variant_id Int?
  quantity   Int             @default(1)
  size       String?
  user       User            @relation(fields: [user_id], references: [id], onDelete: Cascade)
  product    Product         @relation(fields: [product_id], references: [id], onDelete: Cascade)
  variant    ProductVariant? @relation(fields: [variant_id], references: [id], onDelete: SetNull)

  @@index([user_id])
}

// ─── ORDER ───────────────────────────────────────────────────────────────────

model Order {
  id                Int             @id @default(autoincrement())
  user_id           Int
  total             Decimal
  status            String          @default("processing") // "pending" | "processing" | "shipped" | "delivered" | "cancelled" | "cancellation_requested" | "refunded"
  cancel_reason     String?
  payment_id        String?
  razorpay_order_id String?
  shipping_name     String?
  shipping_phone    String?
  shipping_address  String?
  shipping_city     String?
  shipping_state    String?
  shipping_pincode  String?
  created_at        DateTime        @default(now())
  updated_at        DateTime        @default(now()) @updatedAt
  user              User            @relation(fields: [user_id], references: [id])
  items             OrderItem[]
  payments          Payment[]
  returnRequests    ReturnRequest[]

  @@index([user_id])
  @@index([status])
  @@index([created_at])
  @@index([razorpay_order_id])
}

model OrderItem {
  id                Int             @id @default(autoincrement())
  order_id          Int
  product_id        Int
  variant_id        Int?
  sku_snapshot      String?
  quantity          Int
  size              String?
  price_at_purchase Decimal
  order             Order           @relation(fields: [order_id], references: [id], onDelete: Cascade)
  product           Product         @relation(fields: [product_id], references: [id])
  variant           ProductVariant? @relation(fields: [variant_id], references: [id], onDelete: SetNull)

  @@index([order_id])
}

// ─── PAYMENT ─────────────────────────────────────────────────────────────────

model Payment {
  id                 Int      @id @default(autoincrement())
  order_id           Int?
  sale_id            Int?
  gateway            String // "RAZORPAY" | "CASH" | "UPI" | "CARD"
  gateway_order_id   String?
  gateway_payment_id String?  @unique
  amount             Decimal
  currency           String   @default("INR")
  status             String   @default("PENDING") // "PENDING" | "PAID" | "FAILED" | "REFUNDED" | "PARTIALLY_REFUNDED"
  payment_reference  String?
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt
  order              Order?   @relation(fields: [order_id], references: [id], onDelete: SetNull)
  sale               Sale?    @relation(fields: [sale_id], references: [id], onDelete: SetNull)

  @@index([gateway_payment_id])
  @@index([gateway_order_id])
  @@index([status])
}

// ─── POS SALE ────────────────────────────────────────────────────────────────

model Sale {
  id                Int             @id @default(autoincrement())
  invoice_number    String          @unique
  staff_id          Int?
  staff_name        String?         @default("Store Staff")
  customer_id       Int?
  customer_name     String?         @default("Walk-in Customer")
  customer_phone    String?
  subtotal          Decimal
  discount          Decimal         @default(0)
  tax               Decimal         @default(0)
  total             Decimal
  payment_method    String          @default("cash") // "cash" | "upi" | "card" | "online" | "cod"
  amount_received   Decimal?
  change_amount     Decimal?        @default(0)
  payment_ref       String?
  payment_reference String?
  status            String          @default("COMPLETED") // "COMPLETED" | "CANCELLED" | "REFUNDED"
  created_at        DateTime        @default(now())
  updated_at        DateTime        @default(now()) @updatedAt
  staff             User?           @relation("StaffSales", fields: [staff_id], references: [id], onDelete: SetNull)
  items             SaleItem[]
  payments          Payment[]
  returnRequests    ReturnRequest[]

  @@index([created_at])
  @@index([status])
  @@index([staff_id])
  @@index([customer_phone])
}

model SaleItem {
  id                    Int             @id @default(autoincrement())
  sale_id               Int
  variant_id            Int?
  product_id            Int
  product_name          String?
  product_name_snapshot String?
  sku_snapshot          String?
  size                  String?         @default("M")
  size_snapshot         String?
  color_snapshot        String?
  quantity              Int             @default(1)
  price_at_sale         Decimal
  total_price           Decimal
  sale                  Sale            @relation(fields: [sale_id], references: [id], onDelete: Cascade)
  product               Product         @relation(fields: [product_id], references: [id])
  variant               ProductVariant? @relation(fields: [variant_id], references: [id], onDelete: SetNull)

  @@index([sale_id])
}

// ─── RETURN / EXCHANGE ───────────────────────────────────────────────────────

model ReturnRequest {
  id                  Int             @id @default(autoincrement())
  order_id            Int?
  sale_id             Int?
  variant_id          Int?
  product_id          Int
  quantity            Int             @default(1)
  reason              String
  type                String          @default("RETURN") // "RETURN" | "EXCHANGE"
  exchange_variant_id Int? // For exchange: the variant being given to customer
  exchange_quantity   Int? // For exchange: quantity of exchange variant
  condition           String?         @default("RESTOCKABLE") // "RESTOCKABLE" | "DAMAGED"
  customer_name       String?
  customer_phone      String?
  customer_email      String?
  price_difference    Decimal?        @default(0) // positive = customer owes, negative = refund due
  refund_amount       Decimal?        @default(0)
  refund_status       String?         @default("PENDING") // "PENDING" | "COMPLETED" | "NOT_APPLICABLE"
  staff_notes         String?
  created_by          String?
  status              String          @default("REQUESTED") // "REQUESTED" | "APPROVED" | "REJECTED" | "RECEIVED" | "COMPLETED" | "REFUNDED"
  inventory_restored  Boolean         @default(false) // Prevents double-restore
  created_at          DateTime        @default(now())
  updated_at          DateTime        @updatedAt
  product             Product         @relation(fields: [product_id], references: [id], onDelete: Cascade)
  order               Order?          @relation(fields: [order_id], references: [id], onDelete: SetNull)
  sale                Sale?           @relation(fields: [sale_id], references: [id], onDelete: SetNull)
  variant             ProductVariant? @relation("ReturnVariant", fields: [variant_id], references: [id], onDelete: SetNull)
  exchange_variant    ProductVariant? @relation("ExchangeVariant", fields: [exchange_variant_id], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([order_id])
  @@index([sale_id])
  @@index([variant_id])
  @@index([exchange_variant_id])
}

// ─── INVOICE COUNTER ─────────────────────────────────────────────────────────

model InvoiceCounter {
  id            Int      @id @default(autoincrement())
  prefix        String   @unique // e.g. "POS-2026"
  current_count Int      @default(0)
  updated_at    DateTime @updatedAt
}

// ─── ADDRESS ─────────────────────────────────────────────────────────────────

model Address {
  id      Int    @id @default(autoincrement())
  user_id Int
  line1   String
  city    String
  state   String
  pincode String
  phone   String
  user    User   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
}

// ─── WISHLIST ────────────────────────────────────────────────────────────────

model Wishlist {
  id         Int      @id @default(autoincrement())
  user_id    Int
  product_id Int
  created_at DateTime @default(now())
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@unique([user_id, product_id])
}

// ─── COUPON ──────────────────────────────────────────────────────────────────

model Coupon {
  id               Int      @id @default(autoincrement())
  code             String   @unique
  discount_percent Int?
  discount_flat    Decimal?
  min_order_value  Decimal? @default(0)
  is_active        Boolean  @default(true)
  created_at       DateTime @default(now())
}

// ─── REVIEW ──────────────────────────────────────────────────────────────────

model Review {
  id         Int      @id @default(autoincrement())
  user_id    Int
  product_id Int
  rating     Int      @default(5)
  comment    String
  created_at DateTime @default(now())
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@index([product_id])
}

// ─── STOCK NOTIFICATION ──────────────────────────────────────────────────────

model StockNotification {
  id         Int      @id @default(autoincrement())
  user_id    Int?
  email      String
  product_id Int
  size       String?
  created_at DateTime @default(now())
  user       User?    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@index([product_id])
}

// ─── SUPPLIER (Phase 2 ready) ────────────────────────────────────────────────

model Supplier {
  id             Int        @id @default(autoincrement())
  name           String
  contact_person String?
  phone          String?
  email          String?
  gstin          String?
  address        String?
  notes          String?
  is_active      Boolean    @default(true)
  created_at     DateTime   @default(now())
  updated_at     DateTime   @updatedAt
  purchases      Purchase[]

  @@index([name])
}

// ─── PURCHASE / STOCK INWARD (Phase 2 ready) ─────────────────────────────────

model Purchase {
  id              Int            @id @default(autoincrement())
  purchase_number String         @unique
  supplier_id     Int?
  invoice_number  String? // Supplier's invoice number
  purchase_date   DateTime       @default(now())
  subtotal        Decimal        @default(0)
  tax             Decimal        @default(0)
  total           Decimal        @default(0)
  status          String         @default("DRAFT") // "DRAFT" | "ORDERED" | "PARTIALLY_RECEIVED" | "RECEIVED" | "CANCELLED"
  notes           String?
  created_by      String?
  created_at      DateTime       @default(now())
  updated_at      DateTime       @updatedAt
  supplier        Supplier?      @relation(fields: [supplier_id], references: [id], onDelete: SetNull)
  items           PurchaseItem[]

  @@index([supplier_id])
  @@index([status])
  @@index([created_at])
}

model PurchaseItem {
  id          Int            @id @default(autoincrement())
  purchase_id Int
  variant_id  Int
  quantity    Int
  cost_price  Decimal
  total       Decimal
  purchase    Purchase       @relation(fields: [purchase_id], references: [id], onDelete: Cascade)
  variant     ProductVariant @relation(fields: [variant_id], references: [id], onDelete: Cascade)

  @@index([purchase_id])
  @@index([variant_id])
}

// ─── ADMIN AUDIT LOG (Phase 4 ready) ─────────────────────────────────────────

model AdminAuditLog {
  id          Int      @id @default(autoincrement())
  actor_id    Int?
  actor_email String?
  action      String // "product.created" | "stock.adjusted" | "order.cancelled" | "role.changed" etc.
  entity      String // "Product" | "Order" | "Sale" | "User" | "Coupon" etc.
  entity_id   String?
  metadata    Json? // Additional context (NEVER log secrets, passwords, OTPs)
  created_at  DateTime @default(now())
  actor       User?    @relation(fields: [actor_id], references: [id], onDelete: SetNull)

  @@index([actor_id])
  @@index([action])
  @@index([entity])
  @@index([created_at])
}

// ─── INVENTORY RESERVATION (Checkout Holding Lifecycle) ──────────────────────

model InventoryReservation {
  id                Int      @id @default(autoincrement())
  user_id           Int?
  session_id        String? // Optional guest/checkout tracker
  razorpay_order_id String   @unique
  items             Json // [{ variant_id, product_id, sku, quantity, size, price }]
  total_amount      Decimal
  status            String   @default("ACTIVE") // "ACTIVE" | "CONFIRMED" | "RELEASED" | "EXPIRED"
  expires_at        DateTime
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  @@index([razorpay_order_id])
  @@index([status])
  @@index([expires_at])
}

// ─── STORE SETTINGS (Master Control) ─────────────────────────────────────────

model StoreSettings {
  id                  Int      @id @default(autoincrement())
  store_online        Boolean  @default(true)
  online_payments     Boolean  @default(true)
  cod_enabled         Boolean  @default(true)
  new_orders_enabled  Boolean  @default(true)
  whatsapp_number     String   @default("+917666168147")
  support_phone       String   @default("+917666168147")
  support_email       String   @default("support@indiancorporatewear.com")
  atelier_address     String   @default("SUKO Atelier Studio, Bandra West, Mumbai, Maharashtra")
  instagram_url       String   @default("https://instagram.com/icwbysuko")
  facebook_url        String   @default("https://facebook.com/icwbysuko")
  google_review_url   String?  @default("")
  announcement_text   String?
  announcement_active Boolean  @default(false)
  updated_at          DateTime @updatedAt
}

// ─── PROMOTION CAMPAIGNS (Marketing & Dynamic Pricing) ───────────────────────

model PromotionCampaign {
  id                  Int      @id @default(autoincrement())
  title               String
  discount_type       String   // 'percentage' | 'markup_strikethrough' | 'flat'
  discount_value      Decimal  @default(0)
  markup_value        Decimal? @default(0)
  target_type         String   // 'all' | 'category' | 'products'
  target_ids          Int[]    @default([])
  is_active           Boolean  @default(true)
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt
  backup_prices       Json?
}
