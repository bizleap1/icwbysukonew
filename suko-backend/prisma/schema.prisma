generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                          Int                 @id @default(autoincrement())
  email                       String              @unique
  password_hash               String
  name                        String?
  phone                       String?
  role                        String              @default("customer")
  token_version               Int                 @default(1)
  created_at                  DateTime            @default(now())
  updated_at                  DateTime            @default(now()) @updatedAt
  addresses                   Address[]
  orders                      Order[]
  cart_items                  CartItem[]
  cart_merge_requests         CartMergeRequest[]
  wishlist                    Wishlist[]
  reviews                     Review[]
  stock_notifications         StockNotification[]
}

model OtpVerification {
  id            Int       @id @default(autoincrement())
  email         String
  otp_hash      String
  purpose       String
  metadata      Json?
  attempts      Int       @default(0)
  max_attempts  Int       @default(5)
  expires_at    DateTime
  consumed_at   DateTime?
  created_at    DateTime  @default(now())

  @@index([email, purpose])
  @@index([expires_at])
}

model CartMergeRequest {
  id         Int      @id @default(autoincrement())
  user_id    Int
  merge_id   String
  status     String   @default("completed")
  warnings   Json?
  created_at DateTime @default(now())
  expires_at DateTime

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, merge_id])
  @@index([user_id, merge_id])
  @@index([expires_at])
}

model Category {
  id       Int       @id @default(autoincrement())
  name     String
  products Product[]
}

model Product {
  id                 Int                 @id @default(autoincrement())
  name               String
  description        String?
  price              Decimal
  stock              Int
  image_url          String?
  images             String[]            @default([])
  cloudinary_public_id String?
  cloudinary_public_ids String[]         @default([])
  category_id        Int?
  sub_category       String?
  sizes              String[]            @default([])
  size_stock         Json?               @default("{}")
  category           Category?           @relation(fields: [category_id], references: [id])
  created_at         DateTime            @default(now())
  cartItems          CartItem[]
  orderItems         OrderItem[]
  wishlistItems      Wishlist[]
  reviews            Review[]
  stockNotifications StockNotification[]
}

model CartItem {
  id         Int     @id @default(autoincrement())
  user_id    Int
  product_id Int
  quantity   Int
  size       String?
  user       User    @relation(fields: [user_id], references: [id])
  product    Product @relation(fields: [product_id], references: [id])
}

model Order {
  id                    Int         @id @default(autoincrement())
  user_id               Int
  subtotal              Decimal     @default(0) @db.Decimal(12, 2)
  discount              Decimal     @default(0) @db.Decimal(12, 2)
  coupon_code           String?
  total                 Decimal     @db.Decimal(12, 2)
  status                String      @default("payment_pending")
  reservation_status          String?
  expires_at                  DateTime?
  inventory_released_at       DateTime?
  cancel_reason               String?
  status_before_cancel_request String?

  // Exact checkout source cart tracking
  cart_item_ids         Int[]       @default([])

  // Immutable delivery address snapshot
  shipping_name         String?
  shipping_phone        String?
  shipping_line1        String?
  shipping_city         String?
  shipping_state        String?
  shipping_pincode      String?

  // User-scoped checkout idempotency & request fingerprint
  checkout_id           String?
  checkout_fingerprint  String?

  created_at            DateTime    @default(now())
  updated_at            DateTime    @default(now()) @updatedAt
  user                  User        @relation(fields: [user_id], references: [id])
  items                 OrderItem[]
  payments              Payment[]

  @@unique([user_id, checkout_id])
  @@index([user_id, checkout_id])
}

model Payment {
  id                  Int       @id @default(autoincrement())
  order_id            Int
  provider            String    @default("razorpay")
  razorpay_order_id   String    @unique
  razorpay_payment_id String?   @unique
  amount_in_paise     Int
  currency            String    @default("INR")
  status              String    @default("pending")
  error_reason        String?
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt
  order               Order     @relation(fields: [order_id], references: [id], onDelete: Restrict)
}

model OrderItem {
  id                Int     @id @default(autoincrement())
  order_id          Int
  product_id        Int
  quantity          Int
  size              String?
  price_at_purchase Decimal @db.Decimal(12, 2)
  order             Order   @relation(fields: [order_id], references: [id])
  product           Product @relation(fields: [product_id], references: [id])
}

model Address {
  id      Int    @id @default(autoincrement())
  user_id Int
  line1   String
  city    String
  state   String
  pincode String
  phone   String
  user    User   @relation(fields: [user_id], references: [id])
}

model Wishlist {
  id         Int      @id @default(autoincrement())
  user_id    Int
  product_id Int
  created_at DateTime @default(now())
  user       User     @relation(fields: [user_id], references: [id])
  product    Product  @relation(fields: [product_id], references: [id])

  @@unique([user_id, product_id])
}

model Coupon {
  id               Int      @id @default(autoincrement())
  code             String   @unique
  discount_percent Int?
  discount_flat    Decimal?
  min_order_value  Decimal? @default(0)
  is_active        Boolean  @default(true)
  created_at       DateTime @default(now())
}

model Review {
  id         Int      @id @default(autoincrement())
  user_id    Int
  product_id Int
  rating     Int      @default(5)
  comment    String
  created_at DateTime @default(now())
  user       User     @relation(fields: [user_id], references: [id])
  product    Product  @relation(fields: [product_id], references: [id])
}

model StockNotification {
  id         Int      @id @default(autoincrement())
  user_id    Int?
  email      String
  product_id Int
  size       String?
  created_at DateTime @default(now())
  user       User?    @relation(fields: [user_id], references: [id])
  product    Product  @relation(fields: [product_id], references: [id])
}
