{
  "name": "suko-backend",
  "version": "1.0.0",
  "description": "Node.js Express backend for Suko e-commerce platform",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "npx prisma db push --accept-data-loss && node server.js",
    "dev": "node --watch server.js",
    "prisma:generate": "prisma generate",
    "prisma:deploy": "prisma generate && prisma db push --accept-data-loss",
    "test:production": "node testProductionSuite.js"
  },
  "keywords": [
    "express",
    "prisma",
    "e-commerce",
    "suko",
    "neon",
    "postgres"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^5.18.0",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^1.41.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0",
    "multer-storage-cloudinary": "^4.0.0",
    "nodemailer": "^9.0.4",
    "pdfkit": "^0.19.1",
    "razorpay": "^2.9.8",
    "resend": "^6.18.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.4",
    "prisma": "^5.18.0"
  }
}
